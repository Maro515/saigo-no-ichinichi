{
  "sense": {
    "impact": [
      {"t": "音が、ない。", "if": "sudden"},
      {"t": "耳の奥で、高い音が鳴っている。", "k": ["耳"]},
      {"t": "痛みは、まだ来ない。", "k": ["痛"], "if": "sudden"},
      {"t": "空が、かたむいている。", "if": "out", "k": ["空"]},
      {"t": "地面が、すぐそこにある。", "if": "fall", "k": ["地面", "歩道", "道路", "床"]},
      {"t": "指先に、力が入らない。", "k": ["指"]},
      {"t": "口の中に、鉄の味がする。", "k": ["口", "血"]},
      {"t": "体が、冷えていく。", "k": ["冷", "寒"], "late": true},
      {"t": "自分の息だけが、聞こえる。", "k": ["息"]},
      {"t": "まぶたが、重い。", "k": ["まぶた"], "late": true}
    ],
    "chest": [
      {"t": "冷たい汗が、背中をつたう。", "k": ["汗"]},
      {"t": "吸っても、吸っても、足りない。", "if": "self", "k": ["吸"]},
      {"t": "鼓動が、速い。", "k": ["鼓動", "脈", "拍", "心電図", "ゆっくり", "間のび"]},
      {"t": "吐き気が、こみ上げる。", "k": ["吐"]},
      {"t": "手の先が、冷たい。", "k": ["手"], "late": true}
    ],
    "head": [
      {"t": "光が、にじむ。", "k": ["光"]},
      {"t": "目の前が、二重になる。", "k": ["二重"]},
      {"t": "吐き気が、こみ上げる。", "k": ["吐"]}
    ],
    "breath": [
      {"t": "息が、浅い。", "if": "self", "k": ["浅"]},
      {"t": "肩で、息をしている。", "if": "self", "k": ["肩"]},
      {"t": "吸っても、空気が入ってこない。", "if": "self", "k": ["空気", "入って"]},
      {"t": "胸が、ふくらまない。", "if": "self", "k": ["ふくら"], "late": true}
    ],
    "water": [
      {"t": "水が、重い。", "k": ["重"]},
      {"t": "上のほうが、明るい。", "k": ["明る", "光"], "if": "day"},
      {"t": "音が、こもっている。", "k": ["音"]},
      {"t": "泡が、上がっていく。", "k": ["泡"]},
      {"t": "手足が、言うことをきかない。", "k": ["手足"]},
      {"t": "息が、もたない。", "k": ["息"], "late": true, "if": "awake"}
    ],
    "smoke": [
      {"t": "目を、あけていられない。", "k": ["目"], "if": "awake"},
      {"t": "のどが、ひりつく。", "k": ["のど"]},
      {"t": "せきが、止まらない。", "k": ["せき", "咳"], "if": "awake"},
      {"t": "どちらへ行けばいいのか、分からない。", "k": ["どちら", "出口", "道"], "if": "awake"},
      {"t": "頭が、ぼんやりする。", "k": ["頭"], "late": true}
    ],
    "cold": [
      {"t": "指の感覚が、ない。", "if": "exposed", "k": ["指"]},
      {"t": "吐く息が、白い。", "if": "exposed,out", "k": ["息"]},
      {"t": "ふるえが、止まっている。", "if": "exposed", "k": ["ふるえ", "震"], "late": true},
      {"t": "眠い。", "if": "exposed", "k": ["眠"], "late": true},
      {"t": "手足の先が、冷たい。", "if": "ill", "k": ["手足", "冷"]}
    ],
    "heat": [
      {"t": "頭が、ぼうっとする。", "k": ["頭"]},
      {"t": "景色が、ゆれている。", "if": "env,out", "k": ["ゆれ"]},
      {"t": "のどが、からからだ。", "if": "env", "k": ["のど"]},
      {"t": "足に、力が入らない。", "if": "env", "k": ["足"], "late": true},
      {"t": "体が、熱い。", "if": "ill", "k": ["熱"]},
      {"t": "吐く息が、熱い。", "if": "ill", "k": ["息"]}
    ],
    "sleep": [
      {"t": "まぶたが、重い。", "k": ["まぶた"]},
      {"t": "口が、かわく。", "k": ["口"]},
      {"t": "手が、冷たい。", "k": ["手"]},
      {"t": "足の先が、もう分からない。", "k": ["足"]},
      {"t": "息と息のあいだが、長い。", "if": "self", "k": ["あいだ", "間が"], "late": true},
      {"t": "音だけが、近い。", "k": ["音"], "late": true},
      {"t": "体の重さが、なくなる。", "k": ["重"], "late": true}
    ],
    "fade": [
      {"t": "色が、うすくなる。", "k": ["色"]},
      {"t": "音が、遠い。", "k": ["音", "遠"]},
      {"t": "まわりが、暗い。", "k": ["暗"], "late": true}
    ],
    "fall": [
      {"t": "立てない。", "k": ["立"]},
      {"t": "床が、冷たい。", "if": "in", "k": ["床", "冷"]}
    ],
    "choke": [
      {"t": "声が、出ない。", "k": ["声"]},
      {"t": "耳の奥で、脈が鳴っている。", "k": ["脈"]},
      {"t": "目の前が、暗くなっていく。", "k": ["暗"], "late": true}
    ]
  },
  "voice": {
    "bystander": ["大丈夫ですか", "聞こえますか", "救急車、呼びました", "動かさないで", "しっかりしてください", "誰か、来てください"],
    "alarm": ["{呼び名}！", "どうしたの", "しっかりして", "いま、救急車を呼ぶから"],
    "vigil": ["{呼び名}", "ここにいるよ", "聞こえる？", "手、握ってるからね"],
    "farewell": ["ありがとう", "おつかれさま", "ここにいるからね"],
    "staff": ["{名}さん", "{名}さん、聞こえますか", "そばにいますからね"],
    "icu": ["{名}さん、分かりますか", "{名}さん"],
    "rescue": ["大丈夫ですか", "聞こえますか", "救急車、呼びました", "AED、持ってきて", "誰か、来てください"]
  },
  "after": {
    "street": [
      {"t": "信号は、色を変えつづけている。"},
      {"t": "歩道に、人が集まってくる。", "if": "day,sudden"},
      {"t": "遠くで、サイレンが鳴っている。", "if": "sudden"}
    ],
    "car": [
      {"t": "道は、その先へ続いている。"},
      {"t": "となりの車線を、車が走りすぎていく。", "if": "v:city|highway"},
      {"t": "谷から、風が上がってくる。", "if": "v:mountain"}
    ],
    "train": [
      {"t": "次の駅で、扉が開く。"}
    ],
    "living": [
      {"t": "冷蔵庫が、低くうなっている。"},
      {"t": "壁の時計は、止まらずに進む。"}
    ],
    "washitsu": [
      {"t": "庭木が、風にゆれている。"},
      {"t": "障子が、明るくなってくる。", "if": "dawn"},
      {"t": "畳に、日がさしている。", "if": "day,clear"}
    ],
    "bedroom": [
      {"t": "枕もとの時計は、止まらずに進む。"},
      {"t": "カーテンのすきまが、明るくなってくる。", "if": "dawn"}
    ],
    "bath": [
      {"t": "湯は、まだあたたかい。"},
      {"t": "湯気が、天井へのぼっていく。"}
    ],
    "hospital": [
      {"t": "廊下を、足音が通りすぎる。"},
      {"t": "窓の外が、白んでくる。", "if": "dawn"},
      {"t": "どこかの部屋で、ナースコールが鳴っている。"}
    ],
    "icu": [
      {"t": "誰かが、モニターの音を止める。"},
      {"t": "機械の明かりは、ついたままだ。"}
    ],
    "hospice": [
      {"t": "廊下を、静かな足音が通りすぎる。"},
      {"t": "窓の外が、白んでくる。", "if": "dawn"}
    ],
    "facility": [
      {"t": "廊下を、足音が通りすぎる。"},
      {"t": "食堂から、朝のしたくの音がする。", "if": "dawn"}
    ],
    "office": [
      {"t": "空調が、低く鳴りつづけている。"},
      {"t": "パソコンの画面は、ついたままだ。"}
    ],
    "shop": [
      {"t": "入口の戸が、開いて、閉まる。"}
    ],
    "worksite": [
      {"t": "機械の音が、ひとつずつ止まる。"},
      {"t": "遠くで、サイレンが鳴っている。", "if": "sudden"}
    ],
    "park": [
      {"t": "木が、風に鳴っている。"},
      {"t": "遠くで、子どもの声がしている。", "if": "day"}
    ],
    "field": [
      {"t": "風が、畑を渡っていく。"},
      {"t": "山のほうで、鳥が鳴いている。", "if": "day"}
    ],
    "mountain": [
      {"t": "風が、尾根を越えていく。"},
      {"t": "雲が、流れていく。", "if": "day"}
    ],
    "river": [
      {"t": "川は、同じ速さで流れている。"}
    ],
    "sea": [
      {"t": "波は、同じ間隔で寄せてくる。"},
      {"t": "船は、波にゆれている。", "if": "v:boat"}
    ],
    "held": [
      {"t": "{大切な人}は、まだ手を握っている。"}
    ]
  }
}
