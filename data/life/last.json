[
 {
  "id": "lt-001",
  "text": "玄関の鍵は、かけてきたと思う。"
 },
 {
  "id": "lt-002",
  "text": "傘を、どこかに忘れてきた。"
 },
 {
  "id": "lt-003",
  "text": "冷蔵庫に、プリンがひとつ残っている。"
 },
 {
  "id": "lt-004",
  "text": "読みかけの本、あと少しだったのに。"
 },
 {
  "id": "lt-005",
  "text": "やかんの火は、止めたはずだ。"
 },
 {
  "id": "lt-006",
  "text": "風呂の湯は、もうさめただろう。"
 },
 {
  "id": "lt-007",
  "text": "靴ひもが、ほどけている。"
 },
 {
  "id": "lt-008",
  "text": "米を、といだまま出てきた。"
 },
 {
  "id": "lt-009",
  "text": "鉢植えに、今朝は水をやらなかった。"
 },
 {
  "id": "lt-010",
  "text": "ドラマの最終回、来週だった。"
 },
 {
  "id": "lt-011",
  "text": "今夜のごはん、何だったのかな。"
 },
 {
  "id": "lt-012",
  "text": "上着のポケットに、飴がある。"
 },
 {
  "id": "lt-013",
  "text": "爪を、切ろうと思っていたんだった。"
 },
 {
  "id": "lt-014",
  "text": "窓を、閉めてくるんだった。"
 },
 {
  "id": "lt-015",
  "text": "机の引き出し、見られたら困るな。"
 },
 {
  "id": "lt-016",
  "text": "明日は晴れると、天気予報が言っていた。"
 },
 {
  "id": "lt-017",
  "text": "来週の約束、行けなくなった。"
 },
 {
  "id": "lt-018",
  "text": "手紙の返事を、まだ書いていない。"
 },
 {
  "id": "lt-019",
  "text": "新しい歯ブラシ、封も切らなかった。"
 },
 {
  "id": "lt-020",
  "text": "カレンダーを、めくり忘れている。"
 },
 {
  "id": "lt-021",
  "text": "ありがとうと、言いそびれた。"
 },
 {
  "id": "lt-022",
  "text": "ひとこと、謝っておけばよかった。"
 },
 {
  "id": "lt-023",
  "text": "海を、もう一度見たかった。"
 },
 {
  "id": "lt-024",
  "text": "母のにぎり飯は、塩がきつかった。"
 },
 {
  "id": "lt-025",
  "text": "夕立のあとの、土のにおい。"
 },
 {
  "id": "lt-026",
  "text": "坂の上から、町がぜんぶ見えた。"
 },
 {
  "id": "lt-027",
  "text": "あの話、最後まで聞いてやらなかった。"
 },
 {
  "id": "lt-028",
  "text": "今朝の味噌汁、おいしかったな。"
 },
 {
  "id": "lt-029",
  "text": "誰かが、名前を呼んでいる。"
 },
 {
  "id": "lt-030",
  "text": "歌の題名が、どうしても出てこない。"
 },
 {
  "id": "lt-031",
  "text": "小学校の、長い廊下。"
 },
 {
  "id": "lt-032",
  "text": "祖母の家の、柱時計の音。"
 },
 {
  "id": "lt-033",
  "text": "昔の友だちは、いまどこにいるんだろう。"
 },
 {
  "id": "lt-034",
  "text": "遠い花火は、音が遅れて届いた。"
 },
 {
  "id": "lt-035",
  "text": "世話になった、とだけ伝えたい。"
 },
 {
  "id": "lt-036",
  "max": 18,
  "text": "提出のプリント、かばんの底だ。"
 },
 {
  "id": "lt-037",
  "max": 15,
  "text": "明日の時間割、そろえなきゃ。"
 },
 {
  "id": "lt-038",
  "max": 15,
  "text": "上ばき、持って帰るのを忘れた。"
 },
 {
  "id": "lt-039",
  "max": 25,
  "text": "ゲームの続き、セーブしたっけ。"
 },
 {
  "id": "lt-040",
  "max": 25,
  "text": "スマホの充電、あと少ししかなかった。"
 },
 {
  "id": "lt-041",
  "max": 25,
  "text": "友だちのメッセージ、既読のまま返していない。"
 },
 {
  "id": "lt-042",
  "max": 18,
  "text": "部活のユニフォーム、まだ泥だらけだ。"
 },
 {
  "id": "lt-043",
  "max": 22,
  "text": "卒業式の日は、晴れるだろうか。"
 },
 {
  "id": "lt-044",
  "max": 18,
  "text": "弁当、残してごめんなさい。"
 },
 {
  "id": "lt-045",
  "max": 25,
  "text": "好きだと、とうとう言わなかった。"
 },
 {
  "id": "lt-046",
  "max": 25,
  "text": "親に、ひどいことを言ったままだ。"
 },
 {
  "id": "lt-047",
  "max": 25,
  "text": "まだ、何にもなっていないのに。"
 },
 {
  "id": "lt-048",
  "min": 65,
  "text": "朝の薬、飲んだかどうか。"
 },
 {
  "id": "lt-049",
  "min": 65,
  "text": "眼鏡を、どこに置いたんだったか。"
 },
 {
  "id": "lt-050",
  "min": 65,
  "text": "仏壇の花、そろそろ替えどきだった。"
 },
 {
  "id": "lt-051",
  "min": 65,
  "text": "病院の予約は、来週の火曜だった。"
 },
 {
  "id": "lt-052",
  "min": 70,
  "text": "入れ歯は、洗面所のコップの中だ。"
 },
 {
  "id": "lt-053",
  "min": 65,
  "text": "通帳の場所を、誰にも教えていない。"
 },
 {
  "id": "lt-054",
  "min": 65,
  "text": "庭の草が、また伸びているだろう。"
 },
 {
  "id": "lt-055",
  "min": 65,
  "text": "朝の体操に、休むと伝えていない。"
 },
 {
  "id": "lt-056",
  "min": 75,
  "text": "同級生は、あと何人残っているだろう。"
 },
 {
  "id": "lt-057",
  "min": 70,
  "text": "母の年を、とうに越えていた。"
 },
 {
  "id": "lt-058",
  "min": 65,
  "text": "生まれた家の土間は、夏でもひんやりしていた。"
 },
 {
  "id": "lt-059",
  "min": 65,
  "text": "墓の掃除を、頼んでおくんだった。"
 },
 {
  "id": "lt-060",
  "min": 65,
  "text": "年賀状、今年は書けそうにない。"
 },
 {
  "id": "lt-061",
  "min": 65,
  "text": "この湯のみも、ずいぶん長く使った。"
 },
 {
  "id": "lt-062",
  "min": 65,
  "text": "若いころ住んだ部屋の、西日の窓。"
 },
 {
  "id": "lt-063",
  "need": [
   "widowed"
  ],
  "text": "あの人が、角で待っている気がする。"
 },
 {
  "id": "lt-064",
  "need": [
   "widowed"
  ],
  "text": "あの人の時計は、まだ動いている。"
 },
 {
  "id": "lt-065",
  "need": [
   "partner"
  ],
  "text": "あの人と歩いた、川ぞいの道。"
 },
 {
  "id": "lt-066",
  "need": [
   "partner"
  ],
  "text": "あの人に、礼を言ったことがなかった。"
 },
 {
  "id": "lt-067",
  "max": 55,
  "need": [
   "kids"
  ],
  "text": "あの子の弁当箱、流しに置いたきりだ。"
 },
 {
  "id": "lt-068",
  "need": [
   "kids"
  ],
  "text": "あの子の小さな靴は、まだ下駄箱にある。",
  "max": 60
 },
 {
  "id": "lt-069",
  "need": [
   "kids"
  ],
  "text": "あの子を、叱りすぎた日があった。"
 },
 {
  "id": "lt-070",
  "need": [
   "grandkids"
  ],
  "text": "孫の描いた絵が、茶の間の壁にある。"
 }
]
